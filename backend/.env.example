# Application
APP_NAME="Servix Backend API"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"
SECRET_KEY="your-super-secret-jwt-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/servix_db"
POSTGRESS_URI="postgresql://user:password@localhost:5432/servix_db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=False

# CORS
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Marketplace Parameters
PLATFORM_FEE_PERCENTAGE=5.0
ESCROW_AUTO_RELEASE_DAYS=3
DEFAULT_SEARCH_RADIUS_MILES=15.0
